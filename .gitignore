# Study data. Never in git: this is one learner's history and it is not
# reproducible from anything in this repo.
data/
*.db
*.db-wal
*.db-shm
.token

# Private courses. Imported personal material lives here and must never be
# committed: content cannot be removed from git history by a later commit, which
# is exactly why this project is a new repository rather than a rename of its
# predecessor.
courses/*-private/

# Source material for authoring, never shipped. NOT ignored for its size: it is
# NonCommercial-licensed, which is one-way incompatible with the CC BY-SA course
# content, so it must not reach a public repository. See reference/README.md.
reference/*/

# Build output of `repetita build` -- generated from courses/, snapshot-tested in CI
# under tests/, but not committed as a source artifact.
dist/
build/
*.egg-info/

# Generated media. Audio is synthesised from the `audio:` text in course YAML;
# committing binaries makes content PRs unreviewable. See docs/content/audio.md.
media/
courses/**/media/

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

.venv/
venv/

.DS_Store
.idea/
*.swp

# Which port your host app serves on -- local, not a property of the project.
.repetita-host

# Built documentation. `mkdocs build` output; the site is built in CI.
site/
